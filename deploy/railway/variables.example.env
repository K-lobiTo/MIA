# Variables del servicio de la API en Railway (ver "Despliegue en Railway" en docs/OPERACION.md).
# Copiar en Railway: servicio > Variables > Raw Editor, y completar las credenciales.
# No versionar una copia con credenciales.
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/mia?sslmode=require
QDRANT_URL=https://<cluster>.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=mia_chunks
EMBEDDING_PROVIDER=local
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Id del modelo en openrouter.ai/models (modo sin razonamiento, p. ej. Gemini Flash-Lite)
OPENROUTER_MODEL=
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_ZDR=false
OPENROUTER_MAX_TOKENS=8000
# Calibrado con actas reales, ver specs/001-pipeline-ingesta-rag/research.md
QUERY_SIMILARITY_THRESHOLD=0.82
QUERY_SEARCH_LIMIT=8
QUERY_CONTEXT_NEIGHBORS=1
QUERY_FULL_DOCUMENT_MAX_CHUNKS=12
# Con memoria suficiente la ingesta se hace en el servidor, en segundo plano.
INGESTION_ENABLED=true
