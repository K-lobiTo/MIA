# Variables del servicio de la API en Railway (ver "Despliegue en Railway" en docs/OPERACION.md).
# Copiar en Railway: servicio > Variables > Raw Editor, y completar las credenciales.
# No versionar una copia con credenciales.
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/mia?sslmode=require
QDRANT_URL=https://<cluster>.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=mia_chunks
EMBEDDING_PROVIDER=local
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Id del modelo en openrouter.ai/models (modo sin razonamiento, p. ej. Gemini Flash-Lite)
OPENROUTER_MODEL=
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_ZDR=false
OPENROUTER_MAX_TOKENS=8000
# Calibrado con actas reales, ver specs/001-pipeline-ingesta-rag/research.md
QUERY_SIMILARITY_THRESHOLD=0.82
QUERY_SEARCH_LIMIT=8
# Resultados de la búsqueda en el modo con razonamiento
QUERY_SEARCH_LIMIT_RAZONAMIENTO=16
QUERY_CONTEXT_NEIGHBORS=1
QUERY_FULL_DOCUMENT_MAX_CHUNKS=12
# Con memoria suficiente la ingesta se hace en el servidor, en segundo plano.
INGESTION_ENABLED=true

# --- Versión 2: panel de administración, artefactos y topes (ver "Panel de administración" en docs/OPERACION.md) ---
# Clave de automatización para los scripts, alcance global; larga y aleatoria. El panel no la usa. Vacía, queda desactivada.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=
# Inicio de sesión del panel con cuentas del TEC (specs/004-acceso-panel-tec)
# Client ID que entrega TI al registrar la aplicación (docs/REGISTRO_APLICACION_TEC.md). Vacío: el inicio de sesión responde 503
ENTRA_CLIENT_ID=
# Directorio del TEC
ENTRA_TENANT_ID=1119bb90-88ba-4894-b7f1-de26e129d977
# Exigir segundo factor en el token. Solo poner false si la política del TEC no lo emite
ENTRA_REQUIRE_MFA=true
# Tope diario de gasto de toda la API (USD); se reinicia a la medianoche de CAP_TIMEZONE
DAILY_CAP_USD=3
CAP_TIMEZONE=America/Costa_Rica
# Direcciones de los sitios estáticos que llaman a la API (panel, Consulta administrativa), separadas por comas
CORS_ORIGINS=
MAX_UPLOAD_MB=25
# Modelo de cada modo de respuesta. Sin variables propias el modo literal usa LLM_PROVIDER y OPENROUTER_*,
# así que para empezar basta con el modo con razonamiento. Los ids salen de openrouter.ai/models.
LLM_PROVIDER_LITERAL=openrouter
LLM_MODEL_LITERAL=z-ai/glm-5.3-flash
LLM_REASONING_EFFORT_LITERAL=low
LLM_PROVIDER_RAZONAMIENTO=openrouter
LLM_MODEL_RAZONAMIENTO=z-ai/glm-5.3
# medium es el esfuerzo que se probó (15 de 15 en producción). Con high el razonamiento puede consumir todo
# OPENROUTER_MAX_TOKENS y dejar la respuesta vacía; subirlo solo tras probarlo (ver docs/OPERACION.md).
LLM_REASONING_EFFORT_RAZONAMIENTO=medium
# Precios de respaldo (USD por millón de tokens), solo para estimar el costo si OpenRouter no lo informa
# (lo informa siempre; sin estos valores esa estimación daría 0 y los topes no contarían). Referencia: los de
# Z.AI en openrouter.ai/z-ai/glm-5.3 y /glm-5.3-flash; cada proveedor cobra distinto.
LLM_PRICE_IN_LITERAL=0.15
LLM_PRICE_OUT_LITERAL=0.5
LLM_PRICE_IN_RAZONAMIENTO=1.4
LLM_PRICE_OUT_RAZONAMIENTO=4.4

# --- Bot de WhatsApp (feature 011, ver "El bot de WhatsApp" en docs/OPERACION.md y specs/011-bot-whatsapp-kapso/quickstart.md) ---
# Credencial de servicio: valor aleatorio largo, el MISMO que BOT_SERVICE_KEY del servicio `mia-whatsapp`.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SERVICE_KEY=
# Tope mensual de mensajes (recibidos más enviados) por bot; el plan gratuito de Kapso incluye 2.000
BOT_MONTHLY_MESSAGE_CAP=1800
# Tamaño máximo de una imagen asociada a un documento, en MB
MAX_IMAGE_MB=2
# Las imágenes que envía el bot salen de los documentos que la respuesta cita: QUERY_CITED_SOURCES debe estar en on
# (con la opción apagada se enviarían imágenes de documentos que no aportaron a la respuesta)
# QUERY_CITED_SOURCES=on
