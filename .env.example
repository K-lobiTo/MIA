# Qdrant (local vía docker-compose para desarrollo; Qdrant Cloud para producción/demo compartida)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mia_chunks

# Metadata store (MVP: SQLite)
DATABASE_URL=sqlite:///./mia.db

# Proveedores intercambiables (ver docs/Definicion_Requerimientos_MVP.md, sección 7)
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local

# Completar según el proveedor elegido (comercial u local/auto-hospedado)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

API_HOST=0.0.0.0
API_PORT=8000
