# Qdrant (local vía docker-compose para desarrollo; Qdrant Cloud para producción/demo compartida)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mia_chunks

# Metadata store: SQLite para desarrollo; Postgres (Neon) para producción, p. ej.
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/mia?sslmode=require
DATABASE_URL=sqlite:///./mia.db

# Proveedores intercambiables (ver docs/Definicion_Requerimientos_MVP.md, sección 7)
# local: e5-small en ONNX (384 dim, colección mia_chunks). Es el que se usa en producción.
# gemini: gemini-embedding-001 (768 dim, requiere otra colección, p. ej. mia_chunks_gemini;
# el tier gratuito solo permite 1000 textos por día, ver docs/ESCALABILIDAD.md).
EMBEDDING_PROVIDER=local
# LLM: gemini (tier gratuito), openrouter (de pago, prepagado), glm (Z.ai), anthropic
LLM_PROVIDER=gemini

# Anthropic (modelo fijo claude-sonnet-5, nunca claude-opus-5)
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium

# Gemini (modelo fijo gemini-3.5-flash-lite, tier gratuito de Google AI Studio)
GEMINI_API_KEY=

# OpenRouter (saldo prepagado, muchos modelos con una sola clave). OPENROUTER_MODEL es el id del
# modelo en openrouter.ai/models. OPENROUTER_REASONING_EFFORT: none, minimal, low, medium, high
# (vacío: el del modelo; varios modelos razonan siempre y rechazan "none", por eso se usa "low").
# OPENROUTER_MAX_TOKENS acota la respuesta (y el costo) de cada consulta. OPENROUTER_ZDR=true restringe a proveedores de retención cero.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_ZDR=false
OPENROUTER_MAX_TOKENS=8000

# GLM (modelo fijo glm-5.3 de Z.ai, API de pago compatible con la de OpenAI)
GLM_API_KEY=
GLM_THINKING=true

# Umbral mínimo de similitud para considerar un resultado de búsqueda como relevante,
# y límite de resultados a recuperar por consulta (ver specs/001-pipeline-ingesta-rag/research.md)
QUERY_SIMILARITY_THRESHOLD=0.82
QUERY_SEARCH_LIMIT=8
# Resultados en el modo con razonamiento (más que en literal para que entren datos de más documentos)
QUERY_SEARCH_LIMIT_RAZONAMIENTO=16
# Fragmentos vecinos (anteriores y posteriores) que se suman a cada resultado relevante
QUERY_CONTEXT_NEIGHBORS=1
# Documentos cortos (hasta esta cantidad de fragmentos) se pasan completos al LLM; 0 lo desactiva
QUERY_FULL_DOCUMENT_MAX_CHUNKS=12
# Mostrar solo las fuentes que el modelo dice haber usado (on) o todas las que se le entregaron (off, lo de siempre)
QUERY_CITED_SOURCES=off
# Respuestas completas (feature 007). Contexto completo del documento principal (on/off)
QUERY_COMPLETE_CONTEXT=off
# Cuántos documentos (por mejor resultado) reciben el contexto completo
QUERY_COMPLETE_DOCUMENTS=1
# Un documento principal de hasta estos fragmentos se entrega entero
QUERY_COMPLETE_DOCUMENT_MAX_CHUNKS=25
# Si es más largo, fragmentos posteriores que se suman a cada resultado
QUERY_COMPLETE_FORWARD_NEIGHBORS=4
# Tope de caracteres del contexto por consulta (solo con QUERY_COMPLETE_CONTEXT=on)
QUERY_CONTEXT_MAX_CHARS=80000
# Reintentar una vez una respuesta cortada (límite de longitud u otro fin anormal) y avisar si se repite (on/off)
QUERY_RETRY_CUT_ANSWERS=off
# Segundo intento de búsqueda con la pregunta limpia si la primera no pasa el umbral, solo por reglas de
# texto ("¿Quién es X?" busca "X"), sin modelo de lenguaje (on/off)
QUERY_CLEAN_QUESTION=off

# Reranker local (feature 009): un modelo que corre dentro de la API reordena los candidatos de la búsqueda y
# decide el corte de "sin información". No usa ningún servicio externo. none (anterior) o local
RERANK_PROVIDER=none
# Candidatos que se recuperan y puntúan (5 a 60; nunca menos que el límite del modo)
RERANK_CANDIDATES=30
# Puntaje mínimo del reranker, de 0 a 1 (calibrado el 2026-10-18 con scripts/linea_base.py puntajes --rerank:
# con 0.06 ningún caso sin respuesta pasa; con valores altos rechaza documentos que hoy se responden bien)
RERANK_MIN_SCORE=0.06
# Tokens de cada fragmento que lee el reranker (32 a 480; más tokens, más latencia)
RERANK_PASSAGE_TOKENS=128
# Hilos de cálculo del reranker (1 a 8)
RERANK_THREADS=4
# Tiempo máximo de puntuación por consulta en ms (0 lo desactiva); superado, la consulta usa la similitud
RERANK_BUDGET_MS=2500

# Búsqueda híbrida (feature 010): además de la búsqueda por significado, busca por palabras las palabras
# específicas de la pregunta (nombres propios, siglas) con el índice de texto de Qdrant. No usa modelo de
# lenguaje ni servicio externo. Antes de encenderla hay que crear el índice: python scripts/palabras.py preparar
# (sin índice la consulta cae al significado con un aviso). on/off
QUERY_HYBRID_SEARCH=off
# Una palabra es específica si aparece en como máximo este número de fragmentos de los dominios consultados (1 a 500)
HYBRID_MAX_DOC_FREQ=60
# Candidatos léxicos que pasan a la fusión (1 a 100)
HYBRID_LEXICAL_LIMIT=20
# Lugares de la lista final que pueden ocupar los fragmentos que solo llegaron por palabras (0 a 16)
HYBRID_LEXICAL_SLOTS=3
# Palabras (grupos) de la pregunta que se consultan (1 a 16) y letras mínimas de una palabra (3 a 6)
HYBRID_MAX_GROUPS=8
HYBRID_MIN_TOKEN_LEN=3
# Constante de la fusión de las dos listas (1 a 200)
HYBRID_RRF_K=60
# Tiempo máximo de espera de la parte léxica en ms (0 sin tope); superado, la consulta usa el significado
HYBRID_BUDGET_MS=800
# Vigencia en segundos de la caché de la lista de siglas que se edita en el panel (0 la desactiva)
HYBRID_EQUIVALENCES_TTL_SECONDS=60

# false en Render free: la ingesta se hace desde una instancia local (docs/OPERACION.md)
INGESTION_ENABLED=true

# Panel de administración (specs/002-panel-administracion)
# Clave de automatización para los scripts (cargar_carpeta.py, etc.), con alcance global. El panel no la usa.
# Vacía, queda desactivada.
ADMIN_KEY=
# Inicio de sesión del panel con cuentas del TEC (specs/004-acceso-panel-tec)
# Client ID que entrega TI al registrar la aplicación (docs/REGISTRO_APLICACION_TEC.md). Vacío: el inicio de sesión responde 503
ENTRA_CLIENT_ID=
# Directorio del TEC
ENTRA_TENANT_ID=1119bb90-88ba-4894-b7f1-de26e129d977
# Exigir segundo factor en el token. Solo poner false si la política del TEC no lo emite
ENTRA_REQUIRE_MFA=true
# Tope diario de gasto de toda la API (USD) y zona horaria en que el día se reinicia
DAILY_CAP_USD=3
CAP_TIMEZONE=America/Costa_Rica
# Sitios estáticos que pueden llamar a la API (separados por comas); vacío en local (el panel usa el proxy de Vite)
CORS_ORIGINS=
MAX_UPLOAD_MB=25
# Opcional y no recomendada en producción: permite ver el saldo de toda la cuenta de OpenRouter
OPENROUTER_MANAGEMENT_KEY=
# Modelo por modo de respuesta. El literal usa LLM_PROVIDER y OPENROUTER_* si no define el suyo.
# Precios en USD por millón de tokens, solo para estimar el costo si el proveedor no lo informa.
LLM_PROVIDER_LITERAL=openrouter
LLM_MODEL_LITERAL=z-ai/glm-5.3-flash
LLM_REASONING_EFFORT_LITERAL=low
LLM_PRICE_IN_LITERAL=0
LLM_PRICE_OUT_LITERAL=0
LLM_PROVIDER_RAZONAMIENTO=openrouter
LLM_MODEL_RAZONAMIENTO=z-ai/glm-5.3
LLM_REASONING_EFFORT_RAZONAMIENTO=
LLM_PRICE_IN_RAZONAMIENTO=0
LLM_PRICE_OUT_RAZONAMIENTO=0

API_HOST=0.0.0.0
API_PORT=8000
