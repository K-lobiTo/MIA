# Qdrant (local vía docker-compose para desarrollo; Qdrant Cloud para producción/demo compartida)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mia_chunks

# Metadata store: SQLite para desarrollo; Postgres (Neon) para producción, p. ej.
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/mia?sslmode=require
DATABASE_URL=sqlite:///./mia.db

# Proveedores intercambiables (ver docs/Definicion_Requerimientos_MVP.md, sección 7)
# local: e5-small en ONNX (384 dim, colección mia_chunks). Es el que se usa en producción.
# gemini: gemini-embedding-001 (768 dim, requiere otra colección, p. ej. mia_chunks_gemini;
# el tier gratuito solo permite 1000 textos por día, ver docs/ESCALABILIDAD.md).
EMBEDDING_PROVIDER=local
# LLM: gemini (tier gratuito), openrouter (de pago, prepagado), glm (Z.ai), anthropic
LLM_PROVIDER=gemini

# Anthropic (modelo fijo claude-sonnet-5, nunca claude-opus-5)
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium

# Gemini (modelo fijo gemini-3.5-flash-lite, tier gratuito de Google AI Studio)
GEMINI_API_KEY=

# OpenRouter (saldo prepagado, muchos modelos con una sola clave). OPENROUTER_MODEL es el id del
# modelo en openrouter.ai/models. OPENROUTER_REASONING_EFFORT: none, minimal, low, medium, high
# (vacío: el del modelo; varios modelos razonan siempre y rechazan "none", por eso se usa "low").
# OPENROUTER_MAX_TOKENS acota la respuesta (y el costo) de cada consulta. OPENROUTER_ZDR=true restringe a proveedores de retención cero.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_ZDR=false
OPENROUTER_MAX_TOKENS=8000

# GLM (modelo fijo glm-5.3 de Z.ai, API de pago compatible con la de OpenAI)
GLM_API_KEY=
GLM_THINKING=true

# Umbral mínimo de similitud para considerar un resultado de búsqueda como relevante,
# y límite de resultados a recuperar por consulta (ver specs/001-pipeline-ingesta-rag/research.md)
QUERY_SIMILARITY_THRESHOLD=0.82
QUERY_SEARCH_LIMIT=8
# Resultados en el modo con razonamiento (más que en literal para que entren datos de más documentos)
QUERY_SEARCH_LIMIT_RAZONAMIENTO=16
# Fragmentos vecinos (anteriores y posteriores) que se suman a cada resultado relevante
QUERY_CONTEXT_NEIGHBORS=1
# Documentos cortos (hasta esta cantidad de fragmentos) se pasan completos al LLM; 0 lo desactiva
QUERY_FULL_DOCUMENT_MAX_CHUNKS=12

# false en Render free: la ingesta se hace desde una instancia local (docs/OPERACION.md)
INGESTION_ENABLED=true

# Panel de administración (specs/002-panel-administracion)
# Clave para crear dominios, subir documentos y gestionar artefactos. Sin ella esas operaciones responden 503.
ADMIN_KEY=
# Tope diario de gasto de toda la API (USD) y zona horaria en que el día se reinicia
DAILY_CAP_USD=3
CAP_TIMEZONE=America/Costa_Rica
# Sitios estáticos que pueden llamar a la API (separados por comas); vacío en local (el panel usa el proxy de Vite)
CORS_ORIGINS=
MAX_UPLOAD_MB=25
# Opcional y no recomendada en producción: permite ver el saldo de toda la cuenta de OpenRouter
OPENROUTER_MANAGEMENT_KEY=
# Modelo por modo de respuesta. El literal usa LLM_PROVIDER y OPENROUTER_* si no define el suyo.
# Precios en USD por millón de tokens, solo para estimar el costo si el proveedor no lo informa.
LLM_PROVIDER_LITERAL=openrouter
LLM_MODEL_LITERAL=z-ai/glm-5.3-flash
LLM_REASONING_EFFORT_LITERAL=low
LLM_PRICE_IN_LITERAL=0
LLM_PRICE_OUT_LITERAL=0
LLM_PROVIDER_RAZONAMIENTO=openrouter
LLM_MODEL_RAZONAMIENTO=z-ai/glm-5.3
LLM_REASONING_EFFORT_RAZONAMIENTO=
LLM_PRICE_IN_RAZONAMIENTO=0
LLM_PRICE_OUT_RAZONAMIENTO=0

API_HOST=0.0.0.0
API_PORT=8000
