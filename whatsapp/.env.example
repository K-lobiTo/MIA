# Variables del servicio mia-whatsapp (ver specs/011-bot-whatsapp-kapso/contracts/servicio-whatsapp.md).
# Copiar a .env en desarrollo; en Railway van en las variables del servicio. Nunca versionar una copia con claves.

# --- Obligatorias (vacías, el servicio no arranca y el mensaje nombra la variable) ---
# Dirección pública de la API de MIA, con https:// y sin barra final. También forma los enlaces de las imágenes
MIA_API_URL=
# Credencial de servicio: el mismo valor que BOT_SERVICE_KEY de la API
BOT_SERVICE_KEY=
# Clave de la API de Kapso (encabezado X-API-Key)
KAPSO_API_KEY=
# Secreto con que Kapso firma los avisos (el que se eligió al crear el webhook del número)
KAPSO_WEBHOOK_SECRET=

# --- Kapso ---
# Base de la API de Kapso (se cambia para apuntar al simulador local scripts/kapso_falso.py)
KAPSO_API_URL=https://api.kapso.ai/meta/whatsapp/v24.0

# --- Límites (los mismos para todos los bots, BOT-8) ---
# Mensajes por persona por hora (1 a 1000) y por día (1 a 10000)
BOT_MAX_MESSAGES_PER_HOUR=10
BOT_MAX_MESSAGES_PER_DAY=30
# Largo máximo de la pregunta en caracteres (10 a 2000)
BOT_MAX_QUESTION_CHARS=500
# Consultas simultáneas a la API (1 a 50) y consultas en espera antes de descartar (0 a 1000)
BOT_MAX_CONCURRENT_QUERIES=5
BOT_QUEUE_SIZE=20
# Imágenes por respuesta (0 a 10)
BOT_MAX_IMAGES=1
# Horas sin hablar para volver a saludar (1 a 168)
BOT_GREETING_HOURS=24
# Espera máxima de la consulta a la API, en segundos (1 a 120)
BOT_QUERY_TIMEOUT_S=30
# Envíos por minuto a Kapso (1 a 100; el plan gratuito permite 100)
BOT_KAPSO_RATE_PER_MIN=90
# Horas que se recuerda un mensaje ya visto, para no responder dos veces un reintento (1 a 168)
BOT_SEEN_TTL_HOURS=24

# --- Textos fijos (en español, sin contacto del programa; se cambian sin tocar código) ---
# Si se define alguno, debe seguir sin correos, teléfonos ni enlaces (al arrancar se avisa en el registro)
# BOT_TEXT_GREETING=
# BOT_TEXT_NO_INFO=
# BOT_TEXT_UNAVAILABLE=
# BOT_TEXT_RATE_LIMIT=
# BOT_TEXT_NOT_TEXT=
# BOT_TEXT_TOO_LONG=
